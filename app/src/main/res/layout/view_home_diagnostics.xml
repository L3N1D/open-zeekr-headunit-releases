<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/home_connection_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/connection_summary_idle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_report_problem"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textSize="14sp"
            android:maxLines="2"
            android:textAllCaps="false"
            android:text="@string/problem_report_title" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_support_tools" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
            android:textSize="14sp" android:textAllCaps="false" android:text="@string/support_tools" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_quick_action" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
            android:textSize="14sp" android:textAllCaps="false" android:text="@string/support_quick" />
        </LinearLayout>
    </LinearLayout>
