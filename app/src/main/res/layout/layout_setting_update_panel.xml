<?xml version="1.0" encoding="utf-8"?>
<!--
    The updates tab: the app and its version with its status, a card for a new release with what it
    fixes and the download progress in place, and the two switches that decide what the app does on
    its own. UpdatePanel fills it in; a tap on the top card checks again.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/updateAppCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/update_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_update_app_icon">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_steering_wheel"
                    app:tint="@color/update_icon_glyph" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/updateVersionLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="18sp"
                    tools:text="Версия 1.0.2 · проверено сегодня в 21:05" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/updateStatusChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/segment_selected_text"
                android:textSize="17sp"
                app:chipBackgroundColor="@color/segment_selected_bg"
                app:chipIconSize="20dp"
                app:chipIconTint="@color/segment_selected_text"
                app:chipMinHeight="44dp"
                app:chipStrokeWidth="0dp"
                tools:text="Последняя версия" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/updateAvailableCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/update_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/brand_teal"
        app:strokeWidth="2dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/updateAvailableTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Доступна версия 1.0.3" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/updateSizeChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="@color/update_size_text"
                    android:textSize="17sp"
                    app:chipBackgroundColor="@color/update_size_bg"
                    app:chipMinHeight="40dp"
                    app:chipStrokeWidth="0dp"
                    tools:text="25 МБ" />
            </LinearLayout>

            <TextView
                android:id="@+id/updateNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="4"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="18sp"
                tools:text="Исправлено: зависание видео при переключении трека." />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/updateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:max="100"
                android:visibility="gone"
                app:indicatorColor="@color/brand_teal"
                app:trackColor="@color/update_progress_track"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateInstallButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="28dp"
                    android:text="@string/update_install_now"
                    android:textSize="18sp"
                    app:backgroundTint="@color/brand_teal"
                    app:icon="@drawable/ic_download_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateNotesButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="56dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/update_whats_new"
                    android:textColor="@color/segment_selected_text"
                    android:textSize="18sp"
                    app:backgroundTint="@color/segment_selected_bg" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/update_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/updateAtStartRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update_check_at_start"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="19sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/updateAtStartSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/updateReportsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update_send_reports"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="19sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/updateReportsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
