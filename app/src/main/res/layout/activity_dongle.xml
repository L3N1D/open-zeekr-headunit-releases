<?xml version="1.0" encoding="utf-8"?>
<!--
    The dongle's picture. The surface is sized by DongleActivity to cover the screen; until a phone
    projects, a card shows what the dongle is doing with a way back to the home and to its settings.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dongle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <SurfaceView
        android:id="@+id/dongle_video"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- While projecting: over the clock in the AA / CarPlay side rail, where nothing is tappable.
         DongleActivity moves it to the right for right-hand drive. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/dongle_home_small"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:alpha="0.55"
        android:contentDescription="@string/dongle_home"
        android:visibility="gone"
        app:icon="@drawable/ic_arrow_back_white" />

    <FrameLayout
        android:id="@+id/dongle_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
