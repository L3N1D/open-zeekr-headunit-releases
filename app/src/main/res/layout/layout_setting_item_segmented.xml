<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/settingName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Wireless Mode" />

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingName"
        app:layout_constraintEnd_toEndOf="parent">
        
        <com.lenid.zoh.view.SegmentButton
            android:id="@+id/btnOption1"
            style="@style/Widget.OZH.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="Wireless Helper" />

        <com.lenid.zoh.view.SegmentButton
            android:id="@+id/btnOption2"
            style="@style/Widget.OZH.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-1dp"
            android:gravity="center"
            tools:text="Native" />

        <com.lenid.zoh.view.SegmentButton
            android:id="@+id/btnOption3"
            style="@style/Widget.OZH.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-1dp"
            android:gravity="center"
            tools:text="Headunit Server" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
